{"499": {"data": {"tag_id": 499, "tag_name": "音乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "47988": {"data": {"tag_id": 47988, "tag_name": "我的世界", "cover": "http://i0.hdslb.com/bfs/archive/2baa938d85ba419e0c6a6da9e14cd4cd27fb977e.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/4ee35ed657641b7db26acf3699d9813266f4b353.png", "content": "《我的世界》是一款风靡全球的高自由度沙盒游戏，由瑞典Mojang AB和4J Studios开发。", "short_content": "要致富，先撸树。", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "2630": {"data": {"tag_id": 2630, "tag_name": "钢琴", "cover": "http://i0.hdslb.com/bfs/tag/3e5398e13ba833b5681c8405280cee8d974689c4.jpg", "head_cover": "", "content": "源自西洋古典音乐中的一种键盘乐器，由88个琴键和金属弦音板组成，普遍用于独奏、重奏、伴奏等演出，作曲和排练音乐十分方便。弹奏者通过按下键盘上的琴键，牵动钢琴里面包着绒毡的小木槌，继而敲击钢丝弦发出声音。钢琴因为它宽广的音域，绝美的音色，被称为乐器之王。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "994": {"data": {"tag_id": 994, "tag_name": "新世纪福音战士", "cover": "http://i0.hdslb.com/bfs/tag/64834504aeddc9f968a60bddc8b6a45731230f2f.jpg", "head_cover": "", "content": "2000年，一个科学探险队在南极洲针对被称作“第一使徒”亚当的“光之巨人”进行探险。在对其进行接触实验时，“光之巨人”自毁，从而发生了“第二次冲击”，进而导致世界大战。最后，人类人口减半，地轴偏转、气候改变。根据对“第二次冲击”的调查，联合国在日本箱根成立人工进化研究所（即 GEHIRN）从事EVA（指机器人）的发展研究，后GEHIRN利用在人工进化研究所下方发现的巨大空洞建造了总部。\n 　　另一方面，联合国下属秘密组织SEELE为了使人类进化，开始实行人类补完计划，通过中和每个人的AT力场，使每个人回归LCL之海。\n 　　2004年，EVA初号机进行启动试验时发生事故，碇真嗣的母亲碇唯消失，碇源渡开始执行“碇源渡版本的人类补完计划”。2010年，GEHIRN被改建成NERV。\n 　　2015年开始，根据SEELE人类补完计划剧本的安排，“使徒”开始在日本登陆，并向NERV总部进攻，NERV组织EVA消灭使徒。在NERV与使徒作战的同时，碇源渡秘密地执行它自己的计划。随着时间推移，碇源渡的计划逐渐被SEELE发现，NERV与SEELE产生了矛盾并不断恶化…", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "994090": {"data": {"tag_id": 994090, "tag_name": "FGO", "cover": "http://i0.hdslb.com/bfs/archive/8f8d9cb63df57ce3e1982979cb0a8ced353e4210.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/c2667335b6a0ef14ce74330173202d0759e10df4.jpg", "content": "bilibili独家代理的Fate系列首款正版手游。史上最大的圣杯战争，开幕！", "short_content": "夺回未来的战争", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "2498756": {"data": {"tag_id": 2498756, "tag_name": "Fate", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1471141458, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "97431561": {"data": {"tag_id": 97431561, "tag_name": "简中版十周年专属PV", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1783069930, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "6135": {"data": {"tag_id": 6135, "tag_name": "上美影", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "2545441": {"data": {"tag_id": 2545441, "tag_name": "命运-冠位指定", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1472018347, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0