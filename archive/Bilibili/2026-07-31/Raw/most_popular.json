://i2.hdslb.com/bfs/archive/87c7dc91ebe7c7212421120570227e10d16a3f79.jpg", "tidv2": 2078, "tnamev2": "沙盒类", "pid_v2": 1008, "pid_name_v2": "游戏", "attribute_v3": 4, "bvid": "BV1VYGA6hEHL", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 116928102269949, "videos": 1, "tid": 37, "tname": "人文·历史", "copyright": 2, "pic": "http://i2.hdslb.com/bfs/archive/969be3d6eab0ccbe2c76db599353080e06b6e3f3.jpg", "title": "【纪录片】地球·劫后重生 中配版08 美洲洪水", "pubdate": 1785470402, "ctime": 1784185667, "desc": "地球生命演化常被灾难性灭绝打断，却总能在浩劫后涅槃重生，12000年前晚更新世的北美洲，便发生了地球史上规模最大的超级洪水。彼时末次冰期末期，劳伦泰德冰盖融化，融水汇聚成超五大湖总和的冰湖，最终冰岩堤坝溃决，洪水席卷北美，注入大西洋后导致北大西洋暖流崩溃，北半球再度进入冰期。这场灾难重创北美生态，短面熊、猛犸象、乳齿象等冰期巨兽难以适应剧烈气候波动，逐渐走向灭绝。而人类凭借群体协作和生存智慧逆势崛起，成为顶级捕食者，在浩劫中站稳脚跟，为后续主导地球奠定基础。", "state": 0, "duration": 2407, "redirect_url": "https://www.bilibili.com/bangumi/play/ep4998445", "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 1, "hd5": 0, "no_reprint": 0, "autoplay": 0, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 7584632, "name": "哔哩哔哩纪录片", "face": "https://i2.hdslb.com/bfs/face/d655b5efeb97cb4ca5d4926bc53cddee66f429a5.jpg"}, "stat": {"aid": 116928102269949, "view": 710289, "danmaku": 113, "reply": 34, "favorite": 442, "coin": 91, "share": 19, "now_rank": 0, "his_rank": 0, "like": 1363, "dislike": 0, "vt": 0, "vv": 710289, "fav_g": 26, "like_g": 711}, "dynamic": "#地球·劫后重生#第八集中配版更新！1.2万年前的北美洲，爆发地球史上规模最大的超级洪水。短面熊、猛犸象、乳齿象等冰期巨兽难以适应剧烈气候波动，逐渐走向灭绝。而人类凭借群体协作和生存智慧逆势崛起，成为顶级捕食者，在浩劫中站稳脚跟。节目完结，但生命的力量永不停息～", "cid": 39999439913, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1vuKg6BEyM", "up_from_v2": 1, "pub_location": "上海", "cover43": "", "tidv2": 0, "tnamev2": "", "pid_v2": 0, "pid_name_v2": "", "bvid": "BV1vuKg6BEyM", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcm