": {"data": {"tag_id": 167, "tag_name": "猫和老鼠", "cover": "http://i0.hdslb.com/bfs/tag/655d7f13a1961a4e7f35c4bc91abf65e701e8b8b.jpg", "head_cover": "", "content": "《猫和老鼠》（Tom and Jerry）是由威廉·汉纳（William Hanna）和约瑟夫·巴伯拉（Joseph Barbera）自1940年起制作的动画系列。作品共分为163集短剧（1940-2005），5部TV版（1975-2014），10部电影版（1992-2013）。\r\n汉纳-巴伯拉/米高梅动画时期制作114集（1940-1957），期间获得了7次奥斯卡最佳动画短片奖；\r\nGene Deitch/Rembrandt Films cartoons时期制作13集（1961-1962）；\r\n查克·琼斯/Sib Tower 12 cartoons时期制作34集（1963-1967）；\r\n汉纳-巴伯拉/透纳娱乐时期制作1集The Mansion Cat（2001）；\r\n华纳动画时期制作1集The Karate Guard（2005）；\r\n以上为163集短剧作品。\r\n1992制作了首部电影版作品Tom and Jerry: The Movie。\r\n2014年推出新TV版动画。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "91925701": {"data": {"tag_id": 91925701, "tag_name": "updream", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1774664184, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "105989898": {"data": {"tag_id": 105989898, "tag_name": "updream大肥鱼挑战", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1792505510, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7760972": {"data": {"tag_id": 7760972, "tag_name": "大肥鱼", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1531995974, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "14515325": {"data": {"tag_id": 14515325, "tag_name": "亚托莉", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 