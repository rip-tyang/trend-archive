ted": 0, "extra_attr": 1}, "day_count": 1}, "530": {"data": {"tag_id": 530, "tag_name": "OP", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "4672": {"data": {"tag_id": 4672, "tag_name": "JOJO的奇妙冒险", "cover": "http://i0.hdslb.com/bfs/tag/85844f461988f65a44b38c299cae49cb900d4c67.jpg", "head_cover": "", "content": " 19世纪末，英国\r\n    英国贵族乔纳森·乔斯达，是个以绅士精神为目标的少年；下层阶级出身的迪奥（DIO），是企图夺取乔斯达家产，在外佯装好人的俊美男子。在他被收为养子后，处处迫害乔纳森。乔纳森为了打倒因意外得到神秘的石鬼面具而变为吸血鬼的DIO，向一名自称齐贝林的神秘男子学习仙道——波纹气功。\r\n    1938年，美国\r\n    乔纳森·乔斯达死后数十年，他的孙子——乔瑟夫·乔斯达也长大成人了。为了守护他重视的人们，与苏醒的超级生物——柱之男不停的战斗。\r\n\r\n历经六代的伟大冒险故事，以“生存”为关键词，荒木飞吕彦展开他天马行空般的想象力，创造出了一个个光怪陆离的“JOJO”世界。诡异凛冽的画风，令人窒息的剧情，这么多年以来几乎从来都不会令人感到厌倦，少年漫画的必看之作。目前前七部都已经完结，第八部也已经开始连载，舞台又回到了杜王町……根据原著漫画，衍生出了OVA、游戏、小说、手办等周边产品。 ", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "14037": {"data": {"tag_id": 14037, "tag_name": "JOJO", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "58600649": {"data": {"tag_id": 58600649, "tag_name": "动画种草激励计划", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1720067368, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "643464": {"data": {"tag_id": 643464, "tag_name": "飙马野郎", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 143