8": {"data": {"tag_id": 482648, "tag_name": "雪之下雪乃", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "376136": {"data": {"tag_id": 376136, "tag_name": "比企谷八幡", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "189181": {"data": {"tag_id": 189181, "tag_name": "我的青春恋爱物语果然有问题", "cover": "http://i0.hdslb.com/bfs/tag/c966dc44b7c23939146a52539d11a06ec2ee6cf5.jpg", "head_cover": "", "content": "    就读于千叶市立综武高等学校高二年级的比企谷八幡从幼年时代就交不到什么朋友，正当他已经放弃了交朋友这种念头的时候，生活指导老师平冢静介绍他进入了有着学校第一美女——俗称校花的雪之下雪乃所在的奉仕部，奉仕部是一个暗中帮助学生们解决问题的部门，所以不对外招募部员，都是以介绍的方式为部门输送新鲜血液。进入了奉仕部的八幡，和与他有着完全相反血液的由比滨结衣，中二病全开的材木座义辉，网球部的可爱男孩子戸冢彩加等人展开了一段段奇妙的故事\r\n\r\n    《我的青春恋爱物语果然有问题》（やはり俺の青春ラブコメはまちがっている）是渡航撰写，ぽんかん⑧插画的日本轻小说作品，2011年小学馆，GAGAGA文库出版发行。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "103762782": {"data": {"tag_id": 103762782, "tag_name": "Opus5.5", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1790014519, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "373109": {"data": {"tag_id": 373109, "tag_name": "春物", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_