/bfs/storyff/_000036rfd2e8j887m2ejmuxkdfl3h5b_firsti.jpg", "pub_location": "重庆", "cover43": "http://i2.hdslb.com/bfs/archive/021a9f2135b55aaaf94af9b6e34c804b53383f99.jpg", "tidv2": 2166, "tnamev2": "农村生活", "pid_v2": 1023, "pid_name_v2": "三农", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV1kKWA6uEyr", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 117432022734288, "videos": 1, "tid": 172, "tname": "手机游戏", "copyright": 1, "pic": "http://i0.hdslb.com/bfs/archive/b3dbead02b4166f2d0bed68265c135a71ca649ca.jpg", "title": "在冬夜，一块蛋糕，两个冻人", "pubdate": 1791887400, "ctime": 1791870820, "desc": "喜欢你的人，不论你生日送ta什么礼物，对方都会很开心，也会为没能实现的惊喜感到遗憾。但那份遗憾，不会盖过收到你心意时的欢喜。\n\n空把亲手做的生日蛋糕藏进星星，想在芙宁娜许愿时，让它划过夜空，成为一颗为她而来的流星。可他算好了惊喜，却忘了保护里面的蛋糕。星星落进雪地，那份小惊喜也被震得七零八落。\n芙芙当然觉得可惜。但比起蛋糕碎掉的模样，她更心疼空低下头时，那副以为自己搞砸了一切的神情。\n她还是很开心。开心有人亲手为她做了蛋糕，开心两年前那个想去至冬看极光的愿望能被记住，开心在这么冷的夜里，有人陪她站在雪地上", "state": 0, "duration": 128, "mission_id": 4071093, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 1, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 396657882, "name": "叶玲秋雨", "face": "https://i0.hdslb.com/bfs/face/39418591fe2c7d1ce4152f74eab5c830b8a93977.jpg"}, "stat": {"aid": 117432022734288, "view": 579128, "danmaku": 5087, "reply": 2583, "favorite": 19837, "coin": 23591, "share": 5575, "now_rank": 0, "his_rank": 30, "like": 97697, "dislike": 0, "vt": 0, "vv": 579128, "fav_g": 3, "like_g": 2}, "dynamic": "芙芙生日快乐！！", "cid": 42700245277, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "season_id": 2016314, "short_link_v2": "https://b23.tv/BV1uYWA6DEVV", "first_frame": "http://i0.hdslb.com/bfs/storyff/_00001daroh3fljns52gdj8chzwc0xgb_firsti.jpg", "pub_location": "加拿大", "cover43": "http://i2.hdslb.com/bfs/archive/76565b2a2448b57448ea6bfe449ba3ff197d6a38.jpg", "t