[{"aid": 117086529527681, "videos": 2, "tid": 17, "tname": "单机游戏", "copyright": 3, "pic": "http://i1.hdslb.com/bfs/archive/a5739e1fa25eade5ccdce960c171c2e25f4c6f6c.jpg", "title": "WasteTheFallen丨首曝PV＆实机演示：凝视深渊，人性渐泯", "pubdate": 1786637100, "ctime": 1786598925, "desc": "《WasteTheFallen》是一款超自然暗黑生存搜打撤射击游戏。现已开启Steam心愿单，欢迎加入！\n\n世界裂开的时候，没有人听见声音。\n只是从某一天起，缝隙里显露出一些古老的、不该被看见的事物，它们不属于这里，却比我们更像这片土地的主人。如今地表之上，是被异常侵蚀的废弃区域，散落着旧世界所有值钱的东西；地表之下，是没人愿意讨论的黑暗。\n\n如同其他独行者一样，你的那条手臂在那天之后就不再属于人类——它会疼，会在靠近某些地方时发烫，也会让你做到人类做不到的事。\n\n你要一次次回到那些地方。\n\n带上枪，带上", "state": 0, "duration": 311, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 3707041352780493, "name": "WasteTheFallen", "face": "https://i0.hdslb.com/bfs/face/d57c27e022314aa75d567f7f74a8d76b171dba2d.jpg"}, "stat": {"aid": 117086529527681, "view": 1580857, "danmaku": 253, "reply": 736, "favorite": 7907, "coin": 723, "share": 1003, "now_rank": 0, "his_rank": 0, "like": 39815, "dislike": 0, "vt": 0, "vv": 1580857, "fav_g": 0, "like_g": 0}, "dynamic": "", "cid": 40874609007, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1FRgn6pEph", "first_frame": "http://i1.hdslb.com/bfs/storyff/_000000kvsph3nsxs52t3q2se2sw2emb_firsti.jpg", "pub_location": "湖北", "cover43": "http://i1.hdslb.com/bfs/archive/021599adf902a082aa7a753891307c8dd9afe326.jpg", "tidv2": 2079, "tnamev2": "其他游戏", "pid_v2": 1008, "pid_name_v2": "游戏", "attribute_v3": 4, "bvid": "BV1FRgn6pEph", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "百万播放", "corner_mark": 0}}, {"aid": 117074751915890, "videos": 1, "tid": 17, "tname": "单机游戏", "copyright": 3, "pic": "http://i2.hdslb.com/bfs/archive/b9dd5e0997a003c8abde2d48651191e90f03ac01.jpg", "title": "《影之刃零》预购开启，11分钟实机预告公开", "pubdate": 1786500000