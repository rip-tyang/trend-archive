, "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "115171": {"data": {"tag_id": 115171, "tag_name": "新华社", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "4416182": {"data": {"tag_id": 4416182, "tag_name": "中国人民抗日战争", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1503383135, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "4416180": {"data": {"tag_id": 4416180, "tag_name": "世界反法西斯战争", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1503383135, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1071899": {"data": {"tag_id": 1071899, "tag_name": "权御天下", "cover": "http://i0.hdslb.com/bfs/tag/89861295c2d4626c585c12358ac7d182a25b6706.jpg", "head_cover": "", "content": "《权御天下》是哔哩哔哩2015拜年祭的一首由Vocaloid虚拟歌姬洛天依所演唱的中文原创歌曲，因其霸气的曲风和浓重的历史气氛被很多人喜爱。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "11259": {"data": {"tag_id": 11259, "tag_name": "民乐", "cover": "http://i0.hdslb.com/bfs/tag/d380441f7fb2025ea56c2260f63100aec66f003e.png", "head_cover": "", "content": "中国民族音乐是指用中国传统乐器以独奏、合奏形式演奏的民间传统音乐。\n中国民族器乐的历史悠久。从西周到春秋战国时期民间流行吹笙、吹竽、鼓瑟、击筑、弹琴等器乐演奏形式，那时涌现了师涓、师旷等琴家和著名琴曲《高山》和《流水》等。秦汉时的鼓吹乐，魏晋的清商乐，隋唐时的琵琶音乐，宋代的细乐、清乐，元明时的十番锣鼓、弦索等,演奏形式丰富多样。近代的各种体裁和形式,都是传统形式的继承和发展。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1520": {"data": {"tag_id": 1520, "tag_name": "二胡", "cover": "http://i0.hdslb.com/bfs/tag/b3a0cd7f91471fbbde4ef88cbda85a4b829b4d21.jpg", "head_cover": "", "content": "二胡又名“胡琴”，唐代已出现，称“奚琴&quot;，是北方的民间乐器。一般认为今之胡琴由奚琴发展而来，现已成为我国独 具魅力的拉弦乐器。它既适宜表现深沉、悲凄的内容，也能描写气势壮观的意境。 始于唐朝，已有一千多年的历史。它最早发源于我国古代北部地区的一个少数民族，那时叫“奚琴”。宋朝学者陈蜴在《乐书》中记载“奚琴本胡乐也……”唐代诗人岑参所载“中军置酒饮归客，胡琴琵琶与羌笛”的诗句，说明胡琴在唐代已开始流传，而且是中西方拉弦乐器和弹拔乐器的总称。二胡，过去主要流行于长江中下游一带，所以又称为南胡。集中于中高音域的表现，音色接近人声，情感表现力极高，广为大众接受。1920年代，二胡始作为独奏乐器出现在舞台上。在这之前，二胡多用于民间丝竹音乐演奏或民歌、戏曲的伴奏。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "499": {"data": {"tag_id": 499, "tag_name": "音乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "154386": {"data": {"tag_id": 154386, "tag_name": "唢呐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "102132747": {"data": {"tag_id": 102132747, "tag_name": "2026哔需奏乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1788679125, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "