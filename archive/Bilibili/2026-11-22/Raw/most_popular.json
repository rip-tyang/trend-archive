e": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "百万播放", "corner_mark": 1}}, {"aid": 117651921703181, "videos": 1, "tid": 231, "tname": "计算机技术", "copyright": 1, "pic": "http://i1.hdslb.com/bfs/archive/d4cd0919b3d365f5443b59c9167c459b84b799ab.jpg", "title": "Claude 证明了黎曼猜想？11分钟讲清它到底证明了什么、还差哪几步", "pubdate": 1795225988, "ctime": 1795225988, "desc": "只要在那条窄带里找到一个偏离中线的零点，黎曼猜想就会被推翻。1950 年，图灵用曼彻斯特的一台早期计算机，想找的就是那一个。\n\n2026 年 11 月 20 日，数学家阿尔波格与 Claude 公开了一份 Lean 证明，随后通过了多项独立机器检查。同一天公开的另一份广义黎曼猜想草稿仍在修订。\n\n这部片从一个小问题讲起：数到一百万，素数的估算只差约 130 个。再往远处数，误差能有多大？我们把零点的波一层层叠起来，再跟着图灵的思路数一遍，看看怎样知道这一段一个都没漏，以及一份证明怎样回答「所有」。\n\n旁白", "state": 0, "duration": 701, "mission_id": 4072014, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 1, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 3747575452667567, "name": "频谱之外", "face": "https://i2.hdslb.com/bfs/face/c44801269e236b8b8f4bf29dafba2816429d4222.jpg"}, "stat": {"aid": 117651921703181, "view": 961128, "danmaku": 915, "reply": 5720, "favorite": 8838, "coin": 2158, "share": 4929, "now_rank": 0, "his_rank": 0, "like": 17313, "dislike": 0, "vt": 0, "vv": 961128, "fav_g": 0, "like_g": 37}, "dynamic": "", "cid": 43783488052, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV15aytzcENP", "first_frame": "http://i2.hdslb.com/bfs/storyff/_00000y3kurx2g059a2gx6lioevlhaib_firsti.jpg", "pub_location": "英国", "cover43": "http://i2.hdslb.com/bfs/archive/1c7ffbebd796eb6c5f33985af0970994abfb7cc2.jpg", "tidv2": 2098, "tnamev2": "AI杂谈", "pid_v2": 1011, "pid_name_v2": "人工智能", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV15aytzcENP", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 117632023921185, "videos": 1, "tid":