is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "195140": {"data": {"tag_id": 195140, "tag_name": "动作电影", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "74378": {"data": {"tag_id": 74378, "tag_name": "设计", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7950": {"data": {"tag_id": 7950, "tag_name": "成龙", "cover": "http://i0.hdslb.com/bfs/tag/be24fb34d5d816d6afe5fcac0cf4e64990678583.jpg", "head_cover": "", "content": "成龙，生于香港太平山，祖籍山东汶上，大中华区影坛巨星和国际功夫电影巨星，在华人世界享有极高的声望。他与周星驰、周润发并称“双周一成”，意为香港电影的票房保证。多次获得香港金像奖的最佳动作设计奖，并两度获得台湾电影金马奖最佳男主角奖。成龙以功夫片著称，曾多次打破香港电影票房纪录，其主演的电影全球总票房已经超过200亿元，为华人演员之首。成龙的成名作是《醉拳》；1994年由他主演的《红番区》在美国公映后反响强烈，使其成功打入好莱坞；《尖峰时刻》系列电影亦获得极高的票房，并奠定其国际电影巨星的地位。\r\n广告\r\n　　奇强洗衣粉\r\n成龙 代言佳能EOS(7张) \r\n　　格力空调（倡议支持国产） \r\n　　新日电动车 \r\n　　小霸王学习机 \r\n　　爱多vcd（里面有很经典的一个镜头，取自和唐季礼合作的《简单任务》） \r\n　　劲隆摩托 \r\n　　霸王洗发水　 \r\n　　思念水饺 \r\n　　原叶绿茶 \r\n　　佳能EOS \r\n　　北方汽修 \r\n　　卡巴斯基 \r\n　　汾煌可乐", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "21916": {"data": {"tag_id": 21916, "tag_name": "经典电影", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "3141": {"data": {"tag_id": 3141, "tag_name": "电影", "cover": "http://i0.hdslb.com/bfs/tag/f19de3f4c7fd073da5edc0029fdbe8dd3b787498.jpg", "head_cover": "", "content": "电影，也称映画。是由活动照相术和幻灯放映术结合发展起来的一种现代艺术。是一门可以容纳文学戏剧、摄影、绘画、音乐、舞蹈、文字、雕塑、建筑等多种艺术的综合艺术，但它又具有独自的艺术特征。电影在艺术表现力上不但具有其它各种艺术的特征，又因可以运用蒙太奇这种艺术性极强的电影组接技巧，具有超越其它一切艺术的表现手段，而且影片可以大量复制放映。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "551575": {"data": {"tag_id": 551575, "tag_name": "设计教程", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "64845": {"data": {"tag_id": 64845, "tag_name": "雀巢", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "11564": {"data": {"tag_id": 11564, "tag_name": "铠甲勇士", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "2069": {"data": {"tag_id": 2069, "tag_name": "假面骑士", "cover": "http://i0.hdslb.com/bfs/tag/22b79a809cdbfd36cb7ee14781ce8b779a058bc9.jpg", "head_cover": "", "content": "风靡日本的特摄片系列", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "50787": {"data": {"tag_id": 50787, "tag_name": "凡人修仙传", "cover": "http://i0.hdslb.com/bfs/tag/5dc1d0c990fc7cddd5469291