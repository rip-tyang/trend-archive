 1646068363, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "1096": {"data": {"tag_id": 1096, "tag_name": "棋魂", "cover": "http://i0.hdslb.com/bfs/tag/5d42143677d895fd14541e9afca05b45d455e2d6.jpg", "head_cover": "", "content": "《棋魂》（又译为”棋灵王“，日文原名ヒカルの碁），中文意义为“光的围棋”。是日本《少年JUMP周刊》（集英社）于1999年至2003年连载的以围棋为题材的少年漫画，作者是ほったゆみ（堀田由美），漫画由小畑健绘制，并由日本棋院的女棋士梅泽由香里担当监修，后被改编为动画，由东京电视台、电通及Studio Pierrot共同制作，并于东京电视台系列（TXN）在2001年至2003年播放，分为两辑，总共75集。另外，2004年1月3日日本播出特别篇《迈向北斗杯之路》。\r\n　　故事梗概：小学六年级的进藤光为了赚些零用钱，跑到爷爷家里寻宝，偶然翻出了一个旧棋盘。接触棋盘的一瞬间，附身于棋盘中的平安时代棋士——藤原佐为的灵魂进入了小光的体内。佐为将围棋视为生命，在他的熏陶下，小光也逐渐对围棋产生了兴趣……\r\n封面图来源pixiv，id=31811625", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "17046": {"data": {"tag_id": 17046, "tag_name": "剧情", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "3221": {"data": {"tag_id": 3221, "tag_name": "娱乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "116267": {"data": {"tag_id": 116267, "tag_name": "卡牌游戏", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "9790086": {"data": {"tag_id": 9790086, "tag_name": "金铲铲", "cover": "", "head_cover": "