637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "58230": {"data": {"tag_id": 58230, "tag_name": "围棋", "cover": "http://i0.hdslb.com/bfs/tag/5bcb177df268ede5ae0062f3eb3bf2ad75028853.jpg", "head_cover": "", "content": "围棋起源于中国古代，推测起源时间为大约公元前6世纪。是一种策略性两人棋类游戏（也有联棋或团队对战模式，有两人对两人、一人对多人、多人对多人等形式），使用格状棋盘及黑白二色棋子进行对弈。围棋是古代汉族发明的一种智力游戏，中国古时有“弈”、“碁”、“手谈” 等多种称谓，是中国古代知识阶层修身养性的一项必修课目，属于琴棋书画四艺之一。围棋流行于亚太，覆盖世界范围，是一种非常流行的棋类游戏。围棋在很大程度上反应了中国传统思想文化的精髓， 是在中国发展最广的艺术，是中国的国粹，也被认为是世界上最复杂的游戏之一。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "19890": {"data": {"tag_id": 19890, "tag_name": "游戏解说", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1598042": {"data": {"tag_id": 1598042, "tag_name": "柯洁", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1457293083, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "3023780": {"data": {"tag_id": 3023780, "tag_name": "桌游棋牌", "cover": "http://i0.hdslb.com/bfs/archive/457e709debe5e92b244be4cf40173bc42d2e3330.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/8241c82c8296a8bce5cdf20f2a9ad55288608444.jpg", "content": "它是一种面对面的游戏，非常强调交流。因此，桌面游戏是家庭休闲、朋友聚会、甚至商务闲暇等多种场合的最佳沟通方式。", "short_content": "坐下来~开一瓶快乐水~慢慢玩！", "type": 3, "state": 0, "ctime": 1483445538, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "da