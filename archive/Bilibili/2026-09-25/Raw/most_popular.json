6f429a5.jpg"}, "stat": {"aid": 117318055103260, "view": 1921882, "danmaku": 2691, "reply": 387, "favorite": 2596, "coin": 3863, "share": 622, "now_rank": 0, "his_rank": 0, "like": 14729, "dislike": 0, "vt": 0, "vv": 1921882, "fav_g": 0, "like_g": 1110}, "dynamic": "#生命奇观2# 黄渤海湿地！潮起潮落之间，候鸟停歇补给，斑海豹出没海面，蛇岛蝮蠢蠢欲动。无数生命在这条陆海交锋线上，寻找自己的位置。", "cid": 42125365062, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1SxhW6hEK3", "up_from_v2": 5, "pub_location": "上海", "cover43": "", "tidv2": 0, "tnamev2": "", "pid_v2": 0, "pid_name_v2": "", "current_state": 0, "global_state": 0, "bvid": "BV1SxhW6hEK3", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 117325420365704, "videos": 1, "tid": 182, "tname": "影视杂谈", "copyright": 1, "pic": "http://i2.hdslb.com/bfs/archive/f5f773b6e0f9e676035015f5adb0030b8a25d7fb.jpg", "title": "最能打的学渣，用铁拳来整治校园恶霸，终极大战爽翻！爆爽漫改韩剧《学习小组》下", "pubdate": 1790330400, "ctime": 1790244746, "desc": "一黑一白两大强者，在学校里以最野蛮的方式碰撞在一起。\n今天继续来讲超级爽剧：《流氓读书会/学习小组》大结局。\n咱们一起来见证旧王的陨落，与爱好学习者的加冕。", "state": 0, "duration": 2010, "mission_id": 4069899, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 1, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 10119428, "name": "小片片说大片", "face": "https://i2.hdslb.com/bfs/face/949fd3f0b9fe23703c970d494edc41ae52ee32de.jpg"}, "stat": {"aid": 117325420365704, "view": 439478, "danmaku": 973, "reply": 278, "favorite": 3507, "coin": 1827, "share": 233, "now_rank": 0, "his_rank": 0, "like": 20116, "dislike": 0, "vt": 0, "vv": 439478, "fav_g": 0, "like_g": 0}, "dynamic": "高中生杀人事件频发，学生集体成为黑帮替罪羊？", "cid": 42163178301, "dimension": {"width": 1920, "height": 1080, "rotate": 0}, "season_id": 8350993, "short_link_v2": "https://b23.tv/BV1cXaw6tEro", "first_frame": "http://i0.hdslb.com/bfs/s