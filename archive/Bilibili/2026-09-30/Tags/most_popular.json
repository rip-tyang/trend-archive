{"963": {"data": {"tag_id": 963, "tag_name": "奥特曼", "cover": "http://i0.hdslb.com/bfs/tag/0f84368a89745bdbe5dd75bf1e7a5a17cc4ac8e2.jpg", "head_cover": "", "content": "奥特曼（Ultraman 日：ウルトラマン）是日本圆谷株式会社拍摄的科学空想特摄电视连续剧，由杂志连载、电影、电视剧变成节目演变出现。奥特曼在普通人眼中是高大的巨人，就如同神一般的存在，可是他们对于自己的种族，自己的星球来说也只不过是一个普通人。超进化给他们带来了完善的生命形态，同时也使他们背负起了沉重的历史责任，在这种历史责任感驱使下，光之巨人的足迹遍步宇宙，而其中有这么几位巨人，他们来到了我们所在的地球，邂逅了宇宙中最奇妙也是最难以捉摸的生命体—人类。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "28745": {"data": {"tag_id": 28745, "tag_name": "迪迦", "cover": "http://i0.hdslb.com/bfs/tag/19501acb173723b9d19d366c4e373fbb7fee6b8e.jpg", "head_cover": "", "content": "迪迦奥特曼  ", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "29787": {"data": {"tag_id": 29787, "tag_name": "盖亚", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "42899": {"data": {"tag_id": 42899, "tag_name": "戴拿", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1833": {"data": {"tag_id": 1833, "tag_name": "搞笑", "cover": "http://i0.hdslb.com/bfs/archive/4afb90b88597f226d22fdaed28a5c4769b372fdc.png", "head_cover": "", "content": "一起进来每日补充沙雕能量", "short_content": "今天你笑出声了吗？", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0