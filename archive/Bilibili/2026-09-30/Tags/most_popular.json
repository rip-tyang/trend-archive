最佳动画短片奖；\r\nGene Deitch/Rembrandt Films cartoons时期制作13集（1961-1962）；\r\n查克·琼斯/Sib Tower 12 cartoons时期制作34集（1963-1967）；\r\n汉纳-巴伯拉/透纳娱乐时期制作1集The Mansion Cat（2001）；\r\n华纳动画时期制作1集The Karate Guard（2005）；\r\n以上为163集短剧作品。\r\n1992制作了首部电影版作品Tom and Jerry: The Movie。\r\n2014年推出新TV版动画。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7729": {"data": {"tag_id": 7729, "tag_name": "高能", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "421428": {"data": {"tag_id": 421428, "tag_name": "沙雕", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "113843": {"data": {"tag_id": 113843, "tag_name": "抽象", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7740510": {"data": {"tag_id": 7740510, "tag_name": "鬼畜剧场", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1531814011, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "16637150": {"data": {"tag_id": 16637150, "tag_name": "鬼畜星探企划", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1600339256, "count": {"view": 0, "use