 "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "6781": {"data": {"tag_id": 6781, "tag_name": "病娇", "cover": "http://i0.hdslb.com/bfs/tag/e6a66ac094c0cb871c8f3b11a9048dbde3bfd704.jpg", "head_cover": "", "content": "病娇，ACG界用语，多为御宅族所使用，狭义上指那些对异性持有好感处于娇羞的状态下产生精神疾病的患者所表现出来的性格特征，广义上则指在处于精神疾病的状态下与他人发展出感情的人所表现出来的性格特征。以上为其基本定义，但在实际上其定义常常会因使用者的不同而产生不同。具有病娇这种性格特征的人物通常会对某一现象产生常人无法理解与认同的强大情绪、执念，并以此为动力做出过激的示爱、排他、自残、伤害他人等极端行为，且通常会造成悲剧性后果。在现今社会中对于病娇的认知通常有两类，一类极度喜爱，而另一类则持否定态度。（转自百科）", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "106351941": {"data": {"tag_id": 106351941, "tag_name": "乖乖待在我身边不好吗", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1792932749, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "86292": {"data": {"tag_id": 86292, "tag_name": "无限流", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "7227": {"data": {"tag_id": 7227, "tag_name": "副本", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "598764": {"data": {"tag_id": 598764, "tag_name": "数学分析", "cover": "", "head_cover": "", "content": "", "s