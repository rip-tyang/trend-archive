[{"aid": 117392831158223, "videos": 1, "tid": 250, "tname": "出行", "copyright": 1, "pic": "http://i0.hdslb.com/bfs/archive/1954151f4b7fc343379b41785d9d621c2bbe364a.jpg", "title": "去台湾地区管辖的马祖列岛旅行...", "pubdate": 1791280800, "ctime": 1791274039, "desc": "这是距离大陆最近点仅9公里的一片群岛，马祖列岛。它地处福建省福州市的连江县，但因为历史原因，70多年来一直是由TW地区管辖。岛上面写繁体字，用新台币，物资也大多是从TW本岛海运过来的。跟它有着相同命运的还有福建泉州的金门岛（县）。TW地区的最高电影奖项金马奖，名称就来源于金门和马祖。马祖列岛上的居民，祖辈大多来自福州长乐、连江一带的沿海渔民。上世纪四十年代末因为两岸历史变局，便被留在了这片群岛之上。在此后长达半个多世纪里，两岸海上往来被完全隔断，直到1987 年，他们才可以辗转港澳回到福建老家。 2001", "state": 0, "duration": 6656, "mission_id": 4071091, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 1, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 480670664, "name": "赖导AboutLai", "face": "https://i2.hdslb.com/bfs/face/681490e6600ee52089320ed4e5bc6cae7771b4cb.jpg"}, "stat": {"aid": 117392831158223, "view": 951339, "danmaku": 10258, "reply": 3258, "favorite": 15325, "coin": 27803, "share": 3892, "now_rank": 0, "his_rank": 72, "like": 53653, "dislike": 0, "vt": 0, "vv": 951339, "fav_g": 83, "like_g": 1}, "dynamic": "这是距离大陆最近点仅9公里的一片群岛，马祖列岛。它地处福建省福州市的连江县，但因为历史原因，70多年来一直是由台湾地区管辖。岛上面写繁体字，用新台币，物资也大多是从台湾本岛海运过来的。马祖列岛上的居民，祖辈大多来自福州长乐、连江一带的沿海渔民。上世纪四十年代末因为两岸历史变局，便被留在了这片群岛之上。在此后长达半个多世纪里，两岸海上往来被完全隔断，直到2001年“小三通”正式启动，马祖和福州才正式恢复了海上客运航线。2026年，我来到了马祖列岛旅行。", "cid": 42504555111, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1XGpF6CEwq", "first_frame": "http://i2.hdslb.com/bfs/storyff/_00003gc3lhlftw5ox21jfzqmm5ca4db_firsti.jpg", "pub_location": "河北", "cover43": "http://i0.hdslb.com/bfs/archive/4d124a7cf38125be076a876131a0917f816ac751.jpg", "tidv2": 2158, "tnamev2": "旅游记录", "pid_v2": 1022, "pid_name_v2": "旅游出行", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV1XGpF6CEwq", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"co