er": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1600339256, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "3221": {"data": {"tag_id": 3221, "tag_name": "娱乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "47988": {"data": {"tag_id": 47988, "tag_name": "我的世界", "cover": "http://i0.hdslb.com/bfs/archive/2baa938d85ba419e0c6a6da9e14cd4cd27fb977e.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/4ee35ed657641b7db26acf3699d9813266f4b353.png", "content": "《我的世界》是一款风靡全球的高自由度沙盒游戏，由瑞典Mojang AB和4J Studios开发。", "short_content": "要致富，先撸树。", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "20215": {"data": {"tag_id": 20215, "tag_name": "美食", "cover": "http://i0.hdslb.com/bfs/archive/f5a1c84b10080142076feeb0cf6aab18419ae631.png", "head_cover": "http://i0.hdslb.com/bfs/archive/072df021d74459387336fc1e01b694b03ee5786d.jpg", "content": "好饿好饿好饿，我真的好饿~", "short_content": "一到夜里，美食圈露出了…… ", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7144": {"data": {"tag_id": 7144, "tag_name": "热血高校", "cover": "http://i0.hdslb.com/bfs/tag/2dfd18cc346899f53d1912c1dfd1ab0c007e5e5a.jpg", "head_cover": "", "content": "铃兰男子高中是一所恶名远播的学校，这里聚集着一群嗜好打架的不良学生，他们因象征着流血等不吉利事件，而被称为“乌鸦”，为争夺学校霸权，他们又分为诸多派系，其中最强悍的两股势力为：芹泽多摩雄（山田孝之 饰）所带领的芹泽军团，转校生泷谷源治（小栗旬 饰）和地头蛇片桐拳（矢部恭介 饰）联手的新力军。随着两派矛盾的激化，源治和芹泽两大乌鸦军团决一雌雄的时候即将到来……", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "5297": {"data": {"tag_id": 5297, "tag_name": "FPS", "cover": "http://i1.hdslb.com/sp/e6/e63d40a3d92688d85d5bbc555f143576_s.jpg", "head_cover": "", "content": "FPS是第一人称射击类游戏的简称（游戏专有名词）。FPS（First-Person Shooter Game）：第一人称射击游戏。严格来说FPS属于ACT类游戏的一个分支，但和RTS类游戏一样，由于其在世界上的迅速风靡，使之展成了一个单独的类型。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "2513249": {"data": {"tag_id": 2513249, "tag_name": "搞笑小剧场", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1471445043, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "536": {"data": {"tag_id": 536, "tag_name": "原创", "cover": "", "head_cover": "", "content": "1", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "58230": {"data": {"tag_id": 58230, "tag_name": "围棋", "cover": "http://i0.hdslb.com/bfs/tag/5bcb177df268ede5ae0062f3eb3bf2ad75028853.jpg", "head_cover": "", "content": "围棋起源于中国古代，推测起源时间为大约公元前6世纪。是一种策略性两人棋类游戏（也有联棋或团队对战模式，有两人对两人、一人对多人、多人对多人等形式），使用格状棋盘及黑白二色棋子进行对弈。围棋是古代汉族发明的一种智力游戏，中国古时有“弈”、“碁”、“手谈” 等多种称谓，是中国古代知识阶层修身养性的一项必修课目，属于琴棋书画四艺之一。围棋流行于亚太，覆盖世界范围，是一种非常流行的棋类游戏。围棋在很大程度上反应了中国传统思想文化的精髓， 是在中国发展最广的艺术，是中国的国粹，也被认为是世界上最复杂的游戏之一。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "19890": {"dat