9pb_firsti.jpg", "pub_location": "浙江", "cover43": "http://i2.hdslb.com/bfs/archive/c35d4216df7482ee4330d1a09554440e8b64273c.jpg", "tidv2": 2005, "tnamev2": "短剧短片", "pid_v2": 1001, "pid_name_v2": "影视", "attribute_v3": 36, "current_state": 0, "global_state": 0, "bvid": "BV1wue26pE7Y", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "人气飙升", "corner_mark": 1}}, {"aid": 117272622468699, "videos": 1, "tid": 178, "tname": "科学·探索·自然", "copyright": 2, "pic": "http://i0.hdslb.com/bfs/archive/40fd9115f52018e14b6d9a7223ab8ff5177e5f54.png", "title": "【纪录片】生命奇观2 01 内蒙古高原", "pubdate": 1789646402, "ctime": 1789537965, "desc": "说到内蒙古，大部分人的第一印象便是天苍苍、野茫茫的辽阔草原。其实，这片土地远不止于此——内蒙古是中国横跨经度最大的省区，东西直线距离长达2400多公里，幅员之广在国内众多省区中独树一帜。更令人惊叹的是，这里也是我国干湿度分异最显著的省份：从东部湿润的森林，到中部半干旱的草原，再向西延伸至极度干旱的荒漠戈壁，随着降水量梯级递减，自然带依次铺展为森林、草原、荒漠的壮丽序列，仿佛大地书写的一部生态演化史。\n本集以一年三季为线索，展现内蒙古高原横跨草原、火山、森林、盐湖等不同地貌的地理、生物与气象之美。", "state": 0, "duration": 3096, "redirect_url": "https://www.bilibili.com/bangumi/play/ep5975339", "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 1, "hd5": 0, "no_reprint": 0, "autoplay": 0, "ugc_pay": 0, "is_cooperation": 1, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 7584632, "name": "哔哩哔哩纪录片", "face": "https://i2.hdslb.com/bfs/face/d655b5efeb97cb4ca5d4926bc53cddee66f429a5.jpg"}, "stat": {"aid": 117272622468699, "view": 3691041, "danmaku": 4031, "reply": 789, "favorite": 7093, "coin": 9229, "share": 2181, "now_rank": 0, "his_rank": 0, "like": 33201, "dislike": 0, "vt": 0, "vv": 3691041, "fav_g": 0, "like_g": 2908}, "dynamic": "#生命奇观2# 重磅回归！@无穷小亮的科普日常 带队出发，探索广袤内蒙古高原上自然奇观，领略无尽的蓬勃盎然。在方寸之间，尽探生命奥秘！", "cid": 41965323011, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1PUej65E41", "up_from_v2": 5, "pub_location": "上海", "cover43": "", "tidv2": 0, "tnamev2": "", "pid_v2": 0, "pid_name_v2": "", "current_state": 0, "global_state": 0, "bvid": "