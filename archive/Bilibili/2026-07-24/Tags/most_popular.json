王杯半决赛对赫塔菲时复制了马拉多纳在世界杯上的连过五人进球。2008年北京奥运会上，梅西随阿根廷国奥队夺取了金牌。2009年底，他当选了欧洲足球先生和世界足球先生 。2011年，梅西荣膺首届国际足联金球奖，还获得了欧足联欧洲最佳球员。2013年，他以46粒联赛进球的成绩第三次获得欧洲金靴奖奖杯。2014年，梅西随阿根廷队参加2014巴西世界杯。 2014年巴西世界杯上，梅西获世界杯金球奖。\r\n\r\n", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "13807": {"data": {"tag_id": 13807, "tag_name": "科技", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "45892": {"data": {"tag_id": 45892, "tag_name": "评测", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "4978": {"data": {"tag_id": 4978, "tag_name": "世界杯", "cover": "http://i0.hdslb.com/bfs/archive/4bd5c5fe1014a40a50fe377faba67c3b683458f3.jpg", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "584": {"data": {"tag_id": 584, "tag_name": "足球", "cover": "http://i0.hdslb.com/bfs/tag/150a100ebe674fd61d1aa3a8d1fff41705ad9efc.jpg", "head_cover": "", "content": "足球是足球运动或足球比赛的简称\r\n现代足球运动源于英国，亦为当今世界上开展最广、影响最大的体育项目之一，被认为是世界第一运动，在和平年代亦被称作是“国与国间没有硝烟的战争”，甚至因其丰富的内涵和感染力被视作一门艺术。", "short_content": "", "type": 2, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "98622219": {"data": {"ta