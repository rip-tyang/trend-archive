, "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1683880632, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "7357": {"data": {"tag_id": 7357, "tag_name": "小剧场", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "8146729": {"data": {"tag_id": 8146729, "tag_name": "鸣潮", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1535288728, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "23797652": {"data": {"tag_id": 23797652, "tag_name": "绝区零", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1642132791, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "97303293": {"data": {"tag_id": 97303293, "tag_name": "异环1.2版本创作激励", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1782881041, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "17046": {"data": {"tag_id": 17046, "tag_name": "剧情", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1096": {"data": {"tag_id": 1096, "tag_name": "棋魂", "cover": "http://i0.hdslb.com/bfs/tag/5d42143677d895fd14541e9afca05b45d455e2d6.jpg", "head_cover": "", "content": "《棋魂》（又译为”棋灵王“，日文原名ヒカルの碁），中文意义为“光的围棋”。是日本《少年JUMP周刊》（集英社）于1999年至2003年连载的以围棋为题材的少年漫画，作者是ほったゆみ（堀田由美），漫画由小畑健绘制，并由日本棋院的女棋士梅泽由香里担当监修，后被改编为动画，由东京电视台、电通及Studio Pierrot共同制作，并于东京电视台系列（TXN）在2001年至2003年播放，分为两辑，总共75集。另外，2004年1月3日日本播出特别篇《迈向北斗杯之路》。\r\n　　故事梗概：小学六年级的进藤光为了赚些零用钱，跑到爷爷家里寻宝，偶然翻出了一个旧棋盘。接触棋盘的一瞬间，附身于棋盘中的平安时代棋士——藤原佐为的灵魂进入了小光的体内。佐为将围棋视为生命，在他的熏陶下，小光也逐渐对围棋产生了兴趣……\r\n封面图来源pixiv，id=31811625", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "3221": {"data": {"tag_id": 3221, "tag_name": "娱乐", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 3}, "536": {"data": {"tag_id": 536, "tag_name": "原创", "cover": "", "head_cover": "", "content": "1", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 3}, "58230": {"data": {"tag_id": 58230, "tag_name": "围棋", "cover": "http://i0.hdslb.com/bfs/tag/5bcb177df268ede5ae0062f3eb3bf2ad75028853.jpg", "head_cover": "", "content": "围棋起源于中国古代，推测起源时间为大约公元前6世纪。是一种策略性两人棋类游戏（也有联棋或团队对战模式，有两人对两人、一人对多人、多人对多人等形式），使用格状棋盘及黑白二色棋子进行对弈。围棋是古代汉族发明的一种智力游戏，中国古时有“弈”、“碁”、“手谈” 等多种称谓，是中国古代知识阶层修身养性的一项必修课目，属于琴棋书画四艺之一。围棋流行于亚太，覆盖世界范围，是一种非常流行的棋类游戏。围棋在很大程度上反应了中国传统思想文化的精髓， 是在中国发展最广的艺术，是中国的国粹，也被认为是世界上最复杂的游戏之一。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 3}, "1598042": {"data": {"tag_id": 1598042, "tag_name": "柯洁", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1457293083, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 3}, "3023780": {"data": {"tag_id": 3023780, "tag_name": "桌游棋牌", "cover": "http://i0.hdslb.com/bfs/archive/457e709debe5e92b244be4cf40173bc42d2e3330.jpg", "head_cover": "http://i0.hdslb.com/bfs/archive/8241c82c8296a8bce5cdf20f2a9ad55288608444.jpg", "content": "它是一种面对面的游戏，非常强调交流。因此，桌面游戏是家庭休闲、朋友聚会、甚至商务闲暇等多种场合的最佳沟通方式。", "short_content": "坐下来~开一瓶快乐水~慢慢玩！", "type": 3, "state": 0, "ctime": 1483445538, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 2}, "116267": {"data": {"tag_id": 116267, "tag_name": "卡牌游戏", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "9790086": {"data": {"tag_id": 9790086, "tag_name": "金铲铲", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1549995675, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "44332": {"data": {"tag_id": 44332, "tag_name": "暴雨", "cover": "http://i0.hdslb.com/bfs/tag/ea82a435c1f63b281b5fb10407db198bd4366ad1.jpg", "head_cover": "", "content": "《暴雨（Heavy Rain ）》是索尼电脑娱乐（SCE）全球研发工作室与曾开发过《幻象杀手》的Quantic Dream公司联手打造的一款PS3平台独占的交互式电影冒险（AVG）游戏。该作采用了《幻象杀手》改进版本的3D引擎，能够提供包括动态模糊、多重景深在内的多种最新画面特效。从截图可以看出，人物的表情、动作都已经达到目前即时演算的最高水平，角色人物的骨骼做得非常细致，环境的描绘加入了丰富的动态光源。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "at