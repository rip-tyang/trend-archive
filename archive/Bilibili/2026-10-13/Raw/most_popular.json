": "BV1nYpn6DEzp", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 117409558107543, "videos": 1, "tid": 230, "tname": "软件应用", "copyright": 3, "pic": "http://i2.hdslb.com/bfs/archive/fdf459f05c634340a76dbec3c516775956041ca4.jpg", "title": "今年诺奖颁给了“大脑的开关”：光遗传学到底是什么", "pubdate": 1791527846, "ctime": 1791527846, "desc": "电极太粗，药物太慢——脑科学家等一个“又快又准”的开关，等了几十年。 DNA 双螺旋的发现者克里克说过：理想的信号，是光。 \n\n答案最后来自一粒池塘里的藻：它身上有一个蛋白，光一照，0.2 毫秒就开门放电。 2005 年，它被装进神经细胞：蓝光闪一下，细胞放电一下。 从此，脑科学从“只能看”变成了“可以问”。 \n\n这部短片讲清楚 2026 诺贝尔生理学或医学奖：戴瑟罗斯、黑格曼、纳格尔，和他们的光遗传学。 注：它读不了心，也遥控不了任何人——没有装上这个基因的细胞，对光毫无反应。", "state": 0, "duration": 162, "mission_id": 4071536, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 3494362707135250, "name": "比特新语", "face": "https://i1.hdslb.com/bfs/face/acb3f7ba7580f68cf7562768979dea6f395d0ca3.jpg"}, "stat": {"aid": 117409558107543, "view": 380555, "danmaku": 228, "reply": 1543, "favorite": 24220, "coin": 10618, "share": 4641, "now_rank": 0, "his_rank": 0, "like": 65316, "dislike": 0, "vt": 0, "vv": 380555, "fav_g": 0, "like_g": 0}, "dynamic": "", "cid": 42586016012, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1Fbpt6qEPq", "first_frame": "http://i2.hdslb.com/bfs/storyff/_00002gzdaz8m2xa0t2cl80gg8tc7sgb_firsti.jpg", "pub_location": "湖南", "cover43": "http://i2.hdslb.com/bfs/archive/4c910b92374bf0e5d0a8f7ba355e8fb09f4ebea3.jpg", "tidv2": 2094, "tnamev2": "科学科普", "pid_v2": 1010, "pid_name_v2": "知识", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV1Fbpt6qEPq", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "6万点赞", "corner_mark": 1}}, {"aid": 117425915823084, "videos": 1, "tid