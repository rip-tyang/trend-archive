ort_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "21264": {"data": {"tag_id": 21264, "tag_name": "重生", "cover": "http://i0.hdslb.com/bfs/tag/4b0d788f90e11957efa698a1fa0a4c42eb74d4a2.jpg", "head_cover": "", "content": "故事讲述由邵美琪、黄德斌、李逸朗及梁祖仪饰演的一家四口，由于女儿从14岁生日的前夕开始，行为日加怪异，灵异事件也接连出现而使他们惊恐失措。而原来，这一连串的怪异事件正一步一步揭开一个不为人知的事实。", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "61536": {"data": {"tag_id": 61536, "tag_name": "神魔", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 0, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "963": {"data": {"tag_id": 963, "tag_name": "奥特曼", "cover": "http://i0.hdslb.com/bfs/tag/0f84368a89745bdbe5dd75bf1e7a5a17cc4ac8e2.jpg", "head_cover": "", "content": "奥特曼（Ultraman 日：ウルトラマン）是日本圆谷株式会社拍摄的科学空想特摄电视连续剧，由杂志连载、电影、电视剧变成节目演变出现。奥特曼在普通人眼中是高大的巨人，就如同神一般的存在，可是他们对于自己的种族，自己的星球来说也只不过是一个普通人。超进化给他们带来了完善的生命形态，同时也使他们背负起了沉重的历史责任，在这种历史责任感驱使下，光之巨人的足迹遍步宇宙，而其中有这么几位巨人，他们来到了我们所在的地球，邂逅了宇宙中最奇妙也是最难以捉摸的生命体—人类。", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "2947": {"data": {"tag_id": 2947, "tag_name": "特摄", "cover": "http://i0.hdslb.com/bfs/archive/11d6f73281947ac0d0371897241ad9ef5530b6b6.jpg", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1184": {"data": {"tag_id": 1184, "tag_name": "漫画", "cover": "http://i0.hdslb.com/bfs/archive/d67296d4b6668b915314ad128fbd920b6d5b7a8d.jpg", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "1411": {"data": {"tag_id": 1411, "tag_name": "童年", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "13784": {"data": {"tag_id": 13784, "tag_name": "迪迦奥特曼", "cover": "http://i0.hdslb.com/bfs/tag/5849230d7d6a7802512531fd91304625bfff001a.jpg", "head_cover": "", "content": "迪迦在印度尼西亚语中，代表了神圣的数字&amp;amp;amp;amp;quot;3&amp;amp;amp;amp;quot;。大约三千万年以前，地球处于超古代，奇杰拉花朵盛开，邪神加坦杰厄降临，巨人们发生内战，原是地球最强的黑暗战士迪迦在受幽怜的感动后化为光，使其黑暗力量长眠。但超古代文明并没有因此而得救，人们全部都迷上了奇杰拉花的花粉，因为光之巨人无法干涉人类的选择，所以巨人把自己战斗的躯体隐藏在金字塔后，化作光离开了地球", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "413608": {"data": {"tag_id": 413608, "tag_name": "反派", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "792": {"data": {"tag_id": 792, "tag_name": "吐槽", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 2, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "ex