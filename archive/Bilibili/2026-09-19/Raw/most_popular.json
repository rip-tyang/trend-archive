": 626044, "fav_g": 0, "like_g": 0}, "dynamic": "2017年，中国帮肯尼亚修通蒙内铁路，它一度是“一带一路”最耀眼的明星项目。后来，“债务陷阱”“新殖民主义”“中国要拿走蒙巴萨港”的说法铺天盖地，铁路也在奈瓦沙停了整整6年。人们都以为这个项目黄了，没想到，2026年，肯尼亚重启了这个项目，施工方还是中国。本期电子地图册，我们一起走进东非的“一带一路”样板，肯尼亚。", "cid": 41999074317, "dimension": {"width": 1920, "height": 1080, "rotate": 0}, "season_id": 6897981, "short_link_v2": "https://b23.tv/BV1YDem6VEzC", "first_frame": "http://i1.hdslb.com/bfs/storyff/_00002e0qbxqb863cf2aj7tc195l9f4b_firsti.jpg", "pub_location": "上海", "cover43": "http://i1.hdslb.com/bfs/archive/8109ea69ad7d8f80d675dc750ad6a8ca3ae2094c.jpg", "tidv2": 2090, "tnamev2": "人文历史", "pid_v2": 1010, "pid_name_v2": "知识", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV1YDem6VEzC", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}]