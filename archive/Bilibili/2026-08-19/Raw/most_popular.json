: "http://i2.hdslb.com/bfs/storyff/_00003foxm3hnryrf627bq6ipbc1t74b_firsti.jpg", "pub_location": "山西", "cover43": "http://i2.hdslb.com/bfs/archive/4efc408e65ea554c697ca83b37379e1874888ea4.jpg", "tidv2": 2037, "tnamev2": "同人动画", "pid_v2": 1005, "pid_name_v2": "二次元", "attribute_v3": 4, "bvid": "BV18obz6BEiR", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "百万播放", "corner_mark": 1}}, {"aid": 117091344778917, "videos": 1, "tid": 250, "tname": "出行", "copyright": 3, "pic": "http://i0.hdslb.com/bfs/archive/ee304539869a999c72fd80df7d8e2ca5f61c5e60.jpg", "title": "花41元从中国坐火车去蒙古国，曾经的蒙古帝国现在怎么样了，当地人真实生活又如何", "pubdate": 1786700700, "ctime": 1786672618, "desc": "提到蒙古你们会想到什么呢？\n开阔的草原，成群的牛羊，成吉思·汗，还是《乌兰巴托的夜》？\n \n蒙古作为我们的邻国，和我们有着很深的联系\n但同一片草原，却分隔出了两种不同的命运\n那蒙古现在的真实情况到底怎么样？那里的人们又过着什么样的生活？\n\n今天我们将从内蒙坐火车，一路向北前往蒙古国，\n去探访这个 我们既熟悉又陌生的国家，\n看看内蒙、外蒙的差距到底有多大？\n\n话不多说，先点赞后观看，咱们一起出发吧！", "state": 0, "duration": 812, "mission_id": 4067620, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 528461028, "name": "小钟Johnny", "face": "https://i0.hdslb.com/bfs/face/8b5dcb61618876d873d9ea0320e52d86616cca6a.jpg"}, "stat": {"aid": 117091344778917, "view": 2824623, "danmaku": 11854, "reply": 6872, "favorite": 17778, "coin": 13147, "share": 3633, "now_rank": 0, "his_rank": 0, "like": 65117, "dislike": 0, "vt": 0, "vv": 2824623, "fav_g": 0, "like_g": 1647}, "dynamic": "", "cid": 40890533390, "dimension": {"width": 3840, "height": 2160, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1XbgF6SEfr", "first_frame": "http://i1.hdslb.com/bfs/storyff/_00000hx0czt50on5f2oeqjvz1jhu8eb_firsti.jpg", "pub_location": "四川", "cover43": "http://i2.hdslb.com/bfs/archive/98cd99130ec60294c9bb129aadc7dc9ff800b54f.jpg", "tidv2": 2158, "tnamev2": "旅游记录", "pid_v2": 1022, "pid_name_