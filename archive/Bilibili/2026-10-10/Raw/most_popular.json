te": 0, "global_state": 0, "bvid": "BV1pMH46MEmw", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "百万播放", "corner_mark": 1}}, {"aid": 117410396963589, "videos": 1, "tid": 180, "tname": "社会·美食·旅行", "copyright": 2, "pic": "http://i0.hdslb.com/bfs/archive/68dd655b7ee12ebaee8f45ab8548194f346d0ca3.jpg", "title": "【纪录片】中国救护2 04 心是一座城", "pubdate": 1791601201, "ctime": 1791548486, "desc": "急救车面对的，不只有身体的伤病，也有那些不容易被看见和理解的心理困境。医生赵建华、护士张华琴先后遇到心境障碍患者“鸟笼哥”和一名双相情感障碍女孩。面对精神心理危机，急救并不只是判断病情、把人送往医院。患者是否愿意沟通、是否接受帮助，都会影响下一步处置。医护需要判断风险，也需要给对方时间。另一组急救中，医生杨子悦、护士梁磊赶往一个独子突发脑出血的家庭。病情来得突然，父母既要面对未知的结果，也要在短时间内作出艰难的决定。医护能够处理眼前的病情，却无法替家属承担之后的一切。", "state": 0, "duration": 2918, "redirect_url": "https://www.bilibili.com/bangumi/play/ep6538783", "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 1, "hd5": 0, "no_reprint": 0, "autoplay": 0, "ugc_pay": 0, "is_cooperation": 1, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 7584632, "name": "哔哩哔哩纪录片", "face": "https://i2.hdslb.com/bfs/face/d655b5efeb97cb4ca5d4926bc53cddee66f429a5.jpg"}, "stat": {"aid": 117410396963589, "view": 1491569, "danmaku": 1410, "reply": 295, "favorite": 1283, "coin": 382, "share": 157, "now_rank": 0, "his_rank": 0, "like": 3257, "dislike": 0, "vt": 0, "vv": 1491569, "fav_g": 0, "like_g": 611}, "dynamic": "#中国救护2#第四集上线！急救车面对的，不只有身体的伤病，也有那些不容易被看见和理解的心理困境。心境障碍患者“鸟笼哥”经历丧子之痛，直言爸爸说他睡在坟墓里；双相情感障碍女孩情绪突然崩溃，直呼有人叫她去“死”？独子突发脑出血危在旦夕，白发年迈父母艰难作出抉择……每周六中午11点，通过救护车见证人间百态。", "cid": 42594533818, "dimension": {"width": 1920, "height": 1080, "rotate": 0}, "short_link_v2": "https://b23.tv/BV1zKp46YEMp", "up_from_v2": 5, "pub_location": "上海", "cover43": "", "tidv2": 0, "tnamev2": "", "pid_v2": 0, "pid_name_v2": "", "current_state": 0, "global_state": 0, "bvid": "BV1zKp46YEMp", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 11740465