不被打扰的休息。\n\n所谓“阔”，不一定是拥有更多，也可以是给真正重要的事，多留一点。\n\n你最想从忙碌中腾出一点时间，留给什么？", "state": 0, "duration": 2728, "mission_id": 4072848, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 1, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 1730356759, "name": "杨澜", "face": "http://i1.hdslb.com/bfs/face/5dd5c0aa8adaf4490f1be7c5d40e945d0af3faa9.jpg"}, "stat": {"aid": 117529162816291, "view": 1041740, "danmaku": 46, "reply": 150, "favorite": 3348, "coin": 3144, "share": 1309, "now_rank": 0, "his_rank": 0, "like": 5560, "dislike": 0, "vt": 0, "vv": 1041740, "fav_g": 0, "like_g": 96}, "dynamic": "", "cid": 43182459521, "dimension": {"width": 1920, "height": 1080, "rotate": 0}, "short_link_v2": "https://b23.tv/BV15Rxe69E1Z", "up_from_v2": 36, "first_frame": "http://i0.hdslb.com/bfs/storyff/_00000zxkqgc11a5s22ebqpm8yukg1qb_firsti.jpg", "pub_location": "安徽", "cover43": "http://i1.hdslb.com/bfs/archive/1d3148796dcc39ac091b397f4c72a318e1b8affe.jpg", "tidv2": 2107, "tnamev2": "汽车文化", "pid_v2": 1013, "pid_name_v2": "汽车", "attribute_v3": 4, "current_state": 0, "global_state": 0, "bvid": "BV15Rxe69E1Z", "season_type": 0, "is_ogv": false, "ogv_info": null, "enable_vt": 0, "ai_rcmd": null, "rcmd_reason": {"content": "", "corner_mark": 0}}, {"aid": 117523391514476, "videos": 1, "tid": 21, "tname": "日常", "copyright": 3, "pic": "http://i0.hdslb.com/bfs/archive/d8daa2d7bdc17311f9f8ec922fe42575c12462f3.jpg", "title": "画了两万五千里笔，只为点燃的一瞬间", "pubdate": 1793265084, "ctime": 1793265084, "desc": "#画画#艺术#长征#方面面", "state": 0, "duration": 63, "mission_id": 4071650, "rights": {"bp": 0, "elec": 0, "download": 0, "movie": 0, "pay": 0, "hd5": 0, "no_reprint": 0, "autoplay": 1, "ugc_pay": 0, "is_cooperation": 0, "ugc_pay_preview": 0, "no_background": 0, "arc_pay": 0, "pay_free_watch": 0}, "owner": {"mid": 488236820, "name": "画画的方面面", "face": "https://i2.hdslb.com/bfs/face/1683966b