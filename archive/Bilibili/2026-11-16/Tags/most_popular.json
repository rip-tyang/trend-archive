ount": 1}, "74373": {"data": {"tag_id": 74373, "tag_name": "游戏杂谈", "cover": "http://i0.hdslb.com/bfs/tag/6057e57134c1f2e7960cb7daa18aa350e6721dc0.png", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 1}, "day_count": 1}, "589": {"data": {"tag_id": 589, "tag_name": "哲学", "cover": "http://i0.hdslb.com/bfs/tag/fdc6d3c5066ba6bc0f88a411b703d2980cc72b03.jpg", "head_cover": "", "content": "兄贵文化的代表性理念之一.最初来源是因为比利的摔跤视频中常常会有各种不明所里的行为和叫声,总是能引发起观众剧烈的思考: &quot;他们为什么要摔跤!?&quot;&quot;他们为什么要***!?&quot;&quot;为什么要打跟斗!?&quot;&quot;为什么我要看这个视频!?&quot;\r\n随着观众的思考越来越深入,其思考的问题甚至会上升到哲学的地步,所以称为哲♂学.\r\n而兄贵文化发展到现在,哲学这一词汇的含义也在不断发展.在近代日常用语中,哲学可分为名词和形容词.", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "17046": {"data": {"tag_id": 17046, "tag_name": "剧情", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1436866637, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "21744669": {"data": {"tag_id": 21744669, "tag_name": "崩坏：星穹铁道", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 3, "state": 0, "ctime": 1631850749, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extra_attr": 0}, "day_count": 1}, "11273319": {"data": {"tag_id": 11273319, "tag_name": "阿哈", "cover": "", "head_cover": "", "content": "", "short_content": "", "type": 1, "state": 0, "ctime": 1564233880, "count": {"view": 0, "use": 0, "atten": 0}, "is_atten": 0, "likes": 0, "hates": 0, "attribute": 0, "liked": 0, "hated": 0, "extr